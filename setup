#!/usr/bin/env bash
# vi: set ft=sh :
# Bootstrap a new machine: OS packages, stow, then shared setup steps.

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

mkdir -p ~/opt ~/src

case "$(uname -s)" in
  Linux)  . "$DOTFILES/setup_steps/arch.sh" ;;
  Darwin) . "$DOTFILES/setup_steps/macos.sh" ;;
  *)      echo "unsupported OS: $(uname -s)"; exit 1 ;;
esac

"$DOTFILES/stow_all"

. "$DOTFILES/setup_steps/shell.sh"
. "$DOTFILES/setup_steps/ruby.sh"
. "$DOTFILES/setup_steps/neovim.sh"
. "$DOTFILES/setup_steps/tmux_plugins.sh"
