#!/usr/bin/env bash
# Stow the packages listed in packages/common plus packages/<os>.
# Works from any clone location; always targets $HOME. Safe to re-run.

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "$(uname -s)" in
  Linux)  os=linux ;;
  Darwin) os=darwin ;;
  *)      echo "unsupported OS: $(uname -s)"; exit 1 ;;
esac

packages=$(sed 's/#.*//' "$DOTFILES/packages/common" "$DOTFILES/packages/$os")

for package in $packages; do
  stow -d "$DOTFILES" -t "$HOME" -vv "$package"
done
