#!/bin/bash
# Setup script for voice-to-text system
# Shows dependencies and setup instructions

echo "=== Voice-to-Text Setup ==="
echo ""

# Check if running on Arch Linux
if ! command -v pacman &> /dev/null; then
    echo "Warning: This script is designed for Arch Linux"
    echo "You may need to adapt package installation commands"
fi

# Show system dependencies
echo "📦 System dependencies needed:"
echo "   sudo pacman -S --needed python python-pip xdotool portaudio libnotify"
echo ""

# Offer to install
read -p "Install system dependencies now? (y/N) " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    sudo pacman -S --needed python python-pip xdotool portaudio libnotify
    echo "✓ System dependencies installed"
else
    echo "⚠ Skipped. Install manually later."
fi

# Install Python packages
echo ""
echo "📦 Python packages needed:"
echo "   pip install --user google-cloud-speech pyaudio"
echo ""
read -p "Install Python packages now? (y/N) " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    pip install --user --upgrade google-cloud-speech pyaudio
    echo "✓ Python packages installed"
else
    echo "⚠ Skipped. Install manually later."
fi

echo ""
echo "=== Google Cloud Setup Required ==="
echo ""
echo "To use Google Cloud Speech-to-Text API, you need to:"
echo ""
echo "1. Go to: https://console.cloud.google.com/"
echo "2. Create a new project (or select existing)"
echo "3. Enable Speech-to-Text API:"
echo "   https://console.cloud.google.com/apis/library/speech.googleapis.com"
echo "4. Create a service account:"
echo "   https://console.cloud.google.com/iam-admin/serviceaccounts"
echo "5. Download the JSON key file"
echo "6. Save it to: ~/.config/gcloud/speech-to-text-key.json"
echo ""
echo "7. Add to your ~/.zshrc (or ~/.bashrc):"
echo '   export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/gcloud/speech-to-text-key.json"'
echo ""
echo "8. Reload your shell: source ~/.zshrc"
echo ""
echo "=== Free Tier ==="
echo "Google Cloud Speech-to-Text free tier: 60 minutes/month"
echo "After that: \$0.006 per 15 seconds (~\$1.44 per hour)"
echo ""
echo "Setup complete! Follow the steps above to configure Google Cloud."
echo ""
echo "Test with: voice-to-text"
