#!/usr/bin/env python3
"""
Voice-to-Text using Google Cloud Speech-to-Text API
Streams audio from microphone and types transcription into active window.

Usage: voice-to-text
Triggered by keyboard shortcut (configured in i3)
"""

import os
import sys
import queue
import threading
import time
from google.cloud import speech
import pyaudio
import subprocess

# Audio recording parameters
RATE = 16000
CHUNK = int(RATE / 10)  # 100ms chunks

class MicrophoneStream:
    """Opens a recording stream as a generator yielding the audio chunks."""

    def __init__(self, rate=RATE, chunk=CHUNK):
        self._rate = rate
        self._chunk = chunk
        self._buff = queue.Queue()
        self.closed = True

    def __enter__(self):
        self._audio_interface = pyaudio.PyAudio()
        self._audio_stream = self._audio_interface.open(
            format=pyaudio.paInt16,
            channels=1,
            rate=self._rate,
            input=True,
            frames_per_buffer=self._chunk,
            stream_callback=self._fill_buffer,
        )
        self.closed = False
        return self

    def __exit__(self, type, value, traceback):
        self._audio_stream.stop_stream()
        self._audio_stream.close()
        self.closed = True
        self._buff.put(None)
        self._audio_interface.terminate()

    def _fill_buffer(self, in_data, frame_count, time_info, status_flags):
        """Continuously collect data from the audio stream, into the buffer."""
        self._buff.put(in_data)
        return None, pyaudio.paContinue

    def generator(self):
        """Generator yielding audio chunks from the stream."""
        while not self.closed:
            chunk = self._buff.get()
            if chunk is None:
                return
            data = [chunk]

            # Now consume whatever other data's still buffered
            while True:
                try:
                    chunk = self._buff.get(block=False)
                    if chunk is None:
                        return
                    data.append(chunk)
                except queue.Empty:
                    break

            yield b"".join(data)


def show_notification(message, urgency="normal"):
    """Show notification using dunst/notify-send."""
    try:
        subprocess.run(
            ["notify-send", "-u", urgency, "Voice Input", message],
            check=False,
            stderr=subprocess.DEVNULL
        )
    except:
        pass


def type_text(text):
    """Type text into the active window using xdotool."""
    try:
        subprocess.run(
            ["xdotool", "type", "--clearmodifiers", "--", text],
            check=True,
            stderr=subprocess.PIPE
        )
    except subprocess.CalledProcessError as e:
        print(f"Failed to type text: {e}", file=sys.stderr)
        show_notification(f"Failed to type text: {e}", "critical")
    except FileNotFoundError:
        print("xdotool not found. Install it: sudo pacman -S xdotool", file=sys.stderr)
        show_notification("xdotool not installed", "critical")


def listen_print_loop(responses):
    """Iterates through server responses and types transcribed text."""
    show_notification("Listening... (speak now)")

    full_transcript = []
    last_typed_index = 0

    for response in responses:
        if not response.results:
            continue

        result = response.results[0]
        if not result.alternatives:
            continue

        transcript = result.alternatives[0].transcript

        if result.is_final:
            # Final result - type it immediately
            print(f"Final: {transcript}")
            type_text(transcript + " ")
            full_transcript.append(transcript)
            last_typed_index = len(full_transcript)
        else:
            # Interim result - just show in console
            print(f"Interim: {transcript}", end="\r")

    # Show completion notification
    if full_transcript:
        show_notification(f"Typed: {' '.join(full_transcript)}")
    else:
        show_notification("No speech detected", "low")


def main():
    # Check for credentials
    if not os.environ.get("GOOGLE_APPLICATION_CREDENTIALS"):
        show_notification(
            "Google Cloud credentials not set!\n"
            "Set GOOGLE_APPLICATION_CREDENTIALS env var",
            "critical"
        )
        print("Error: GOOGLE_APPLICATION_CREDENTIALS not set", file=sys.stderr)
        sys.exit(1)

    show_notification("Starting voice input...")

    # Configure speech recognition
    client = speech.SpeechClient()
    config = speech.RecognitionConfig(
        encoding=speech.RecognitionConfig.AudioEncoding.LINEAR16,
        sample_rate_hertz=RATE,
        language_code="en-US",
        # Enable automatic punctuation
        enable_automatic_punctuation=True,
        # Use enhanced model for better accuracy
        use_enhanced=True,
        model="default",
    )

    streaming_config = speech.StreamingRecognitionConfig(
        config=config,
        interim_results=True,  # Get results as you speak
        single_utterance=False,  # Don't stop after first pause
    )

    try:
        with MicrophoneStream() as stream:
            audio_generator = stream.generator()
            requests = (
                speech.StreamingRecognizeRequest(audio_content=content)
                for content in audio_generator
            )

            responses = client.streaming_recognize(streaming_config, requests)

            # Start a timer to auto-stop after 30 seconds
            timeout = 30
            timer = threading.Timer(timeout, lambda: setattr(stream, 'closed', True))
            timer.start()

            try:
                listen_print_loop(responses)
            finally:
                timer.cancel()

    except KeyboardInterrupt:
        print("\nStopped by user")
        show_notification("Voice input cancelled", "low")
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        show_notification(f"Error: {e}", "critical")
        sys.exit(1)


if __name__ == "__main__":
    main()
